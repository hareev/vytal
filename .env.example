# ── Frontend (Vite) ───────────────────────────────────────────────────────────

# Claude AI — required for AI health diagnosis
VITE_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API server URL (defaults to http://localhost:3001 if not set)
VITE_API_URL=http://localhost:3001

# Set to "true" to run without a backend (uses in-memory mock data)
VITE_USE_MOCK=true

# Optional: override the default Claude model
# VITE_CLAUDE_MODEL=claude-sonnet-4-20250514


# ── API Server ────────────────────────────────────────────────────────────────

# Anthropic API key for server-side Channel Capture processing
# Same key as VITE_ANTHROPIC_API_KEY — keeps server-side processing out of the browser
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/vytal?sslmode=require

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-strong-random-string

# CORS allowed origin (defaults to * in dev)
# CORS_ORIGIN=https://your-frontend-domain.com

# API server port (default: 3001)
# PORT=3001


# ── Channel Capture Integrations ──────────────────────────────────────────────

# Gmail — create credentials at console.cloud.google.com (OAuth 2.0 Client ID)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=http://localhost:3001/api/integrations/gmail/callback

# Microsoft (Outlook + Teams) — register app at portal.azure.com
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=http://localhost:3001/api/integrations/outlook/callback
# MICROSOFT_TENANT_ID=common

# Slack — create app at api.slack.com/apps
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_REDIRECT_URI=http://localhost:3001/api/integrations/slack/callback
# SLACK_SIGNING_SECRET=
